<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center">

    <!-- Top mini header: Dhikr name + target badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_dhikr_arabic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="سُبْحَانَ اللَّٰهِ"
            android:textColor="@color/widget_emerald_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_target_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_target_badge_bg"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="/33"
            android:textColor="@color/widget_gold_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Transliteration or progress -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar_emerald" />

    <!-- Center Count -->
    <TextView
        android:id="@+id/widget_count_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/widget_text_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <!-- Bottom Actions: Reset (small) + +1 Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/widget_btn_reset"
            android:layout_width="32dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_secondary"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Reset Tasbeeh Counter"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/widget_btn_increment"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_increment_pill"
            android:text="+1"
            android:textColor="@color/widget_text_on_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:contentDescription="Count +1" />
    </LinearLayout>

</LinearLayout>
