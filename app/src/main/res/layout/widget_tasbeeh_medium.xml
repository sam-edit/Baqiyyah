<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center">

    <!-- Top Header: Dhikr Arabic Name + Reset & Settings Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_dhikr_arabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سُبْحَانَ اللَّٰهِ"
                android:textColor="@color/widget_emerald_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_dhikr_translit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SubhanAllah"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Target Badge -->
        <TextView
            android:id="@+id/widget_target_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_target_badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="/33"
            android:textColor="@color/widget_gold_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <!-- Reset Button -->
        <ImageButton
            android:id="@+id/widget_btn_reset"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_secondary"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Reset Tasbeeh Counter"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:layout_marginEnd="4dp" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/widget_btn_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_secondary"
            android:src="@drawable/ic_widget_settings"
            android:contentDescription="Widget Settings"
            android:scaleType="centerInside"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Subtle Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar_emerald" />

    <!-- Center Content: Big Count + Tap Target & +1 Pill Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Count Display Column -->
        <LinearLayout
            android:id="@+id/widget_count_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical|start">

            <TextView
                android:id="@+id/widget_count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/widget_text_primary"
                android:textSize="44sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_laps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lap 0 • Total: 0"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- +1 Action Button (Large Touch Target Pill) -->
        <Button
            android:id="@+id/widget_btn_increment"
            android:layout_width="88dp"
            android:layout_height="62dp"
            android:background="@drawable/widget_btn_increment_pill"
            android:text="+1"
            android:textColor="@color/widget_text_on_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:contentDescription="Count +1" />
    </LinearLayout>

</LinearLayout>
